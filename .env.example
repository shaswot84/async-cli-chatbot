# Never commit the real .env file.
LLM_API_KEY="replace_me"
LLM_BASE_URL="https://your-provider.example.com/v1"
LLM_CHAT_COMPLETIONS_PATH="/chat/completions"

DEFAULT_MODEL="llama-3.1-8b-instant"
REQUEST_TIMEOUT_SECONDS="60"
MAX_CONCURRENCY="2"
REQUESTS_PER_MINUTE="6"
MAX_OUTPUT_TOKENS="400"

SQLITE_PATH="data/chatbot.sqlite3"
LOG_LEVEL="INFO"
LOG_JSON="true"

PROMETHEUS_ENABLED="true"
PROMETHEUS_PORT="9464"

SIMULATE_FAILURES="false"
SIMULATE_FAILURE_RATE="0.0"
SIMULATE_FAILURE_KIND="429"

# Phase 1 API-key feasibility checks.
# Keep these conservative so the free tier is not burned during validation.
PREFLIGHT_MAX_TOKENS="400"
PREFLIGHT_TEMPERATURE="0.0"
PREFLIGHT_SAFE_REQUESTS_PER_MINUTE="6"
PREFLIGHT_BURST_CONCURRENCY="2"
PREFLIGHT_RATE_TEST_REQUESTS="8"
PREFLIGHT_REPORT_PATH="reports/api_key_preflight_report.md"
